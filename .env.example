APP_NAME="Your QR"
APP_ENV=development
APP_PORT=3000
# Make one with `dox key:generate`. Keep it secret.
APP_KEY=
# The public base URL of the short links.
APP_URL=http://localhost:3000

# Postgres and Redis from `docker compose up -d postgres redis`
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=your_qr
REDIS_HOST=localhost
REDIS_PORT=6379

# Set while `npm run dev` runs. Empty: the built files in public/build.
VITE_DEV_SERVER=
